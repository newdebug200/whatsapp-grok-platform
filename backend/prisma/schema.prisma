generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  name               String
  role               String    @default("user")
  created_at         DateTime  @default(now())
  reset_token        String?
  reset_token_expiry DateTime?
  credit_balance     Float     @default(0)
  is_blocked         Boolean   @default(false)

  whatsappProfiles    WhatsAppProfile[]
  creditTransactions  CreditTransaction[]
  paymentTransactions PaymentTransaction[]
  dressurQueueItems   DressurQueueItem[]
}

model WhatsAppProfile {
  id           Int      @id @default(autoincrement())
  account_id   Int
  phone_number String
  display_name String?
  is_connected Boolean  @default(false)
  created_at   DateTime @default(now())

  account              Account               @relation(fields: [account_id], references: [id])
  botConfig            BotConfig?
  contacts             Contact[]
  faqs                 FAQ[]
  campaigns            Campaign[]
  verificationTriggers VerificationTrigger[]
  sensitiveKeywords    SensitiveKeyword[]
  sensitiveFlags       SensitiveFlag[]
  tags                 Tag[]
  quickReplies         QuickReply[]
  statuses             Status[]

  @@unique([account_id, phone_number])
}

model BotConfig {
  id                     Int     @id @default(autoincrement())
  profile_id             Int     @unique
  bot_name               String  @default("Botora")
  bot_info               String  @default("")
  bot_behavior           String  @default("")
  ia_enabled             Boolean @default(true)
  response_delay_seconds Int     @default(5)

  business_hours_enabled Boolean @default(false)
  open_days              String  @default("1,2,3,4,5")
  open_time              String  @default("09:00")
  close_time             String  @default("18:00")
  timezone               String  @default("UTC")
  away_message           String  @default("")
  away_once_per_session  Boolean @default(true)

  personality            String  @default("professional")
  system_prompt_override String?
  sentiment_alert        Boolean @default(true)
  media_auto_reply       Boolean @default(true)

  profile WhatsAppProfile @relation(fields: [profile_id], references: [id])
}

model Contact {
  id                Int      @id @default(autoincrement())
  profile_id        Int
  phone_number      String
  wa_id             String?
  name              String?
  created_at        DateTime @default(now())
  ia_paused         Boolean  @default(false)
  sensitive_flagged Boolean  @default(false)
  archived          Boolean  @default(false)
  notes             String?
  funnel_stage      String   @default("prospect")
  unread_count      Int      @default(0)
  is_favorite       Boolean  @default(false)

  messages          Message[]
  profile           WhatsAppProfile  @relation(fields: [profile_id], references: [id])
  campaignTargets   CampaignTarget[]
  sensitiveFlagLogs SensitiveFlag[]
  tags              ContactTag[]
  memory            ContactMemory?

  @@unique([profile_id, phone_number])
}

model ContactMemory {
  id         Int      @id @default(autoincrement())
  contact_id Int      @unique
  summary    String
  updated_at DateTime @updatedAt

  contact Contact @relation(fields: [contact_id], references: [id], onDelete: Cascade)
}

model Tag {
  id         Int      @id @default(autoincrement())
  profile_id Int
  name       String
  color      String   @default("#25d366")
  created_at DateTime @default(now())

  profile   WhatsAppProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  contacts  ContactTag[]
  campaigns Campaign[]

  @@unique([profile_id, name])
}

model ContactTag {
  contact_id Int
  tag_id     Int

  contact Contact @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([contact_id, tag_id])
}

model Message {
  id         Int      @id @default(autoincrement())
  contact_id Int
  content    String
  direction  String
  type       String
  created_at DateTime @default(now())
  unread     Boolean  @default(true)
  sentiment  String?
  media_path String?

  contact Contact @relation(fields: [contact_id], references: [id])
}

model FAQ {
  id         Int      @id @default(autoincrement())
  profile_id Int
  question   String
  answer     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile WhatsAppProfile @relation(fields: [profile_id], references: [id])
}

model QuickReply {
  id         Int      @id @default(autoincrement())
  profile_id Int
  title      String
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile WhatsAppProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

model Campaign {
  id                Int       @id @default(autoincrement())
  profile_id        Int
  name              String
  status            String    @default("draft")
  created_at        DateTime  @default(now())
  scheduled_at      DateTime?
  started_at        DateTime?
  completed_at      DateTime?
  delay_min_seconds Int       @default(20)
  delay_max_seconds Int       @default(60)

  tag_id Int?

  profile  WhatsAppProfile   @relation(fields: [profile_id], references: [id])
  tag      Tag?              @relation(fields: [tag_id], references: [id], onDelete: SetNull)
  messages CampaignMessage[]
  targets  CampaignTarget[]
}

model CampaignMessage {
  id                  Int     @id @default(autoincrement())
  campaign_id         Int
  content             String
  order_index         Int     @default(0)
  delay_after_seconds Int     @default(0)
  media_url           String?
  media_type          String?
  media_path          String?

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
}

model CampaignTarget {
  id          Int       @id @default(autoincrement())
  campaign_id Int
  contact_id  Int
  status      String    @default("pending")
  sent_at     DateTime?
  error       String?

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
}

model VerificationTrigger {
  id         Int      @id @default(autoincrement())
  profile_id Int
  text       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  profile WhatsAppProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

model SensitiveKeyword {
  id         Int      @id @default(autoincrement())
  profile_id Int
  keyword    String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  profile WhatsAppProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

model SensitiveFlag {
  id              Int      @id @default(autoincrement())
  profile_id      Int
  contact_id      Int
  keyword_matched String
  message_content String
  flagged_at      DateTime @default(now())

  profile WhatsAppProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  contact Contact         @relation(fields: [contact_id], references: [id], onDelete: Cascade)
}

model Status {
  id         Int      @id @default(autoincrement())
  profile_id Int
  content    String
  type       String   @default("text")
  wa_msg_id  String?
  created_at DateTime @default(now())

  profile WhatsAppProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

model PlatformConfig {
  key   String @id
  value String
}

model DressurQueueItem {
  id         Int       @id @default(autoincrement())
  account_id Int
  source_key String
  numero     String
  message    String
  wa_id      String?
  position   Int       @default(0)
  status     String    @default("pending")
  error      String?
  sent_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@unique([account_id, source_key])
  @@index([account_id, status])
}

model PaymentTransaction {
  id              Int                   @id @default(autoincrement())
  account_id      Int
  provider        String                @default("fedapay")
  external_id     String                @unique
  amount_xof      Int
  credits         Float
  status          String                @default("pending")
  description     String?
  metadata        String?
  approved_at     DateTime?
  last_checked_at DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  account         Account               @relation(fields: [account_id], references: [id], onDelete: Cascade)
  webhookEvents   PaymentWebhookEvent[]

  @@index([account_id, created_at])
  @@index([account_id, status])
}

model PaymentWebhookEvent {
  id          Int                 @id @default(autoincrement())
  payment_id  Int?
  event_id    String              @unique
  event_type  String
  payload     String
  received_at DateTime            @default(now())
  payment     PaymentTransaction? @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  @@index([event_type, received_at])
}

model CreditTransaction {
  id          Int      @id @default(autoincrement())
  account_id  Int
  amount      Float
  type        String
  description String?
  tokens_used Int?
  created_at  DateTime @default(now())

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?
  price         Float    @default(0)
  currency      String   @default("XOF")
  credits       Float    @default(0)
  duration_days Int      @default(30)
  max_profiles  Int      @default(1)
  features      String?
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([is_active, sort_order])
}
