generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  name       String
  created_at DateTime @default(now())

  whatsappSession WhatsAppSession?
  botConfig       BotConfig?
  contacts        Contact[]
  faqs            FAQ[]
}

model WhatsAppSession {
  id           Int      @id @default(autoincrement())
  account_id   Int      @unique
  is_connected Boolean  @default(false)
  created_at   DateTime @default(now())
  account      Account  @relation(fields: [account_id], references: [id])
}

model BotConfig {
  id           Int     @id @default(autoincrement())
  account_id   Int     @unique
  bot_name     String  @default("SanRobot")
  bot_info     String  @default("")
  bot_behavior String  @default("")
  ia_enabled   Boolean @default(true)
  account      Account @relation(fields: [account_id], references: [id])
}

model Contact {
  id           Int       @id @default(autoincrement())
  account_id   Int
  phone_number String
  name         String?
  created_at   DateTime  @default(now())
  messages     Message[]
  account      Account   @relation(fields: [account_id], references: [id])

  @@unique([account_id, phone_number])
}

model Message {
  id         Int      @id @default(autoincrement())
  contact_id Int
  content    String
  direction  String
  type       String
  created_at DateTime @default(now())
  contact    Contact  @relation(fields: [contact_id], references: [id])
}

model FAQ {
  id         Int      @id @default(autoincrement())
  account_id Int
  question   String
  answer     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  account    Account  @relation(fields: [account_id], references: [id])
}
