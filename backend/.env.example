PORT=3001
DATABASE_URL=file:./dev.db
GROK_API_KEY=your_groq_api_key_here
JWT_SECRET=your_super_secret_jwt_key_change_this

# URL de retour après paiement, traitée par le service central
FEDAPAY_CALLBACK_URL=https://your-domain.example/?payment=return
APP_URL=https://your-domain.example
GROQ_MODEL=openai/gpt-oss-20b

# Credit unit: 1 credit = 100,000 tokens = 120 XOF
CREDIT_TOKENS_PER_CREDIT=100000
CREDIT_VALUE_XOF=120
CREDIT_COST_XOF=60

# Paiements, décisions et télémétrie centralisés via botora-admin.
# Les appels interservices de récupération et de consommation utilisent cette clé.
# En auto : localhost:8000 en local, domaine public en production.
# BOTORA_ADMIN_API_MODE peut forcer auto, local ou online.
BOTORA_ADMIN_API_MODE=auto
# BOTORA_ADMIN_API_URL, si défini, remplace la détection automatique.
# BOTORA_ADMIN_API_URL=https://botora.bluelifetech.site
# En local, la clé de développement est partagée automatiquement.
# En production, définir une clé forte identique à BOTORA_SERVICE_KEY dans botora-admin.
# BOTORA_ADMIN_SERVICE_KEY=votre_cle_interservices_forte
